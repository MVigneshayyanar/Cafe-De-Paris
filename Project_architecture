## API Abstraction Layer

All API calls go through a single file in each client. The API is hosted at `lcdp-server`.

### `Svelte Website/src/lib/api.js`
```js
const BASE_URL = 'https://api.cafedeparis.com/v1'; // ← swap here

const get = (path) => fetch(`${BASE_URL}${path}`, { headers: authHeaders() }).then(r => r.json());
const post = (path, body) => fetch(`${BASE_URL}${path}`, { method: 'POST', headers: authHeaders(), body: JSON.stringify(body) }).then(r => r.json());
const patch = (path, body) => fetch(`${BASE_URL}${path}`, { method: 'PATCH', headers: authHeaders(), body: JSON.stringify(body) }).then(r => r.json());

export const api = {
  // Auth
  sendOtp: (phone) => post('/auth/otp/send', { phone }),
  verifyOtp: (phone, code) => post('/auth/otp/verify', { phone, code }),
  managerLogin: (email, password) => post('/auth/manager/login', { email, password }),
  ownerLogin: (email, password) => post('/auth/owner/login', { email, password }),

  // Tables
  getTables: () => get('/tables'),
  getTable: (id) => get(`/tables/${id}`),

  // Menu
  getMenu: (category) => get(`/menu?category=${category}`),

  // Orders
  getOrders: () => get('/orders'),
  sendToKitchen: (tableId, items) => post('/orders', { tableId, items }),
  markServed: (orderId) => patch(`/orders/${orderId}/served`),

  // Inventory
  getInventory: () => get('/inventory'),
  addInventoryItem: (item) => post('/inventory', item),

  // Bills
  scanBill: (imageBase64) => post('/bills/scan', { image: imageBase64 }),
  confirmBill: (billData) => post('/bills/confirm', billData),

  // Payables
  getPayables: () => get('/payables'),
  markPaid: (id) => patch(`/payables/${id}/paid`),

  // Vendors
  getVendors: () => get('/vendors'),
  addVendor: (vendor) => post('/vendors', vendor),

  // Analytics (Owner)
  getOverview: (date) => get(`/analytics/overview?date=${date}`),
  getRevenue: (period) => get(`/analytics/revenue?period=${period}`),
  getSalesPerformance: () => get('/analytics/sales'),
  getInventoryInsights: () => get('/analytics/inventory'),
  getReports: () => get('/reports'),

  // KDS
  getKitchenOrders: () => get('/kitchen/orders'),
  startOrder: (id) => patch(`/kitchen/orders/${id}/start`),
  readyOrder: (id) => patch(`/kitchen/orders/${id}/ready`),

  // Alerts
  getAlerts: () => get('/alerts'),
};
```

